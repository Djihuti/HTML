<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpaceEngine</RootNamespace>
    <Nullable>disable</Nullable>
    <WarningLevel>4</WarningLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Kompilierreihenfolge = Abhaengigkeitsreihenfolge (F# ist reihenfolgesensitiv). -->
  <ItemGroup>
    <Compile Include="Math3D.fs" />
    <Compile Include="WebGLRenderer.fs" />
    <Compile Include="ProceduralMeshes.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Camera.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Browser.WebGL" Version="1.3.0" />
  </ItemGroup>

</Project>
